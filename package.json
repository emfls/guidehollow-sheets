{
  "name": "guidehollow-sheets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:publisher": "python3 -m unittest discover -s tests -p 'test_notion_publisher.py' -v",
    "test:browser": "node scripts/browser-csv-smoke.mjs"
  },
  "dependencies": { "astro": "7.4.2" },
  "devDependencies": { "@astrojs/check": "0.9.9", "typescript": "5.9.3" }
}
