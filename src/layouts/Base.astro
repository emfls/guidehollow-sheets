---
import {site} from '../config';
import '../styles/global.css';
interface Props {title:string;description?:string;noindex?:boolean;schema?:Record<string,unknown>;breadcrumbs?:{name:string;url:string}[]}
const {title,description=site.description,noindex=false,schema,breadcrumbs=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname==='/404/'?'/404.html':Astro.url.pathname,site.url).href;
const pageTitle=title===site.name?`${title} — Practical spreadsheet help`:`${title} | ${site.name}`;
const graph=[{'@type':'Organization','@id':`${site.url}/#publisher`,name:site.name,url:site.url,logo:`${site.url}/favicon.svg`},{'@type':'WebSite','@id':`${site.url}/#website`,name:site.name,url:site.url,inLanguage:site.language},...(breadcrumbs.length?[{'@type':'BreadcrumbList',itemListElement:[{name:'Home',url:'/'},...breadcrumbs].map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,site.url).href}))}]:[]),...(schema?[schema]:[])];
---
<!doctype html><html lang="en-US"><head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{pageTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta name="robots" content={noindex?'noindex, follow':'index, follow'}/><meta name="theme-color" content="#123d44"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="GuideHollow Sheets RSS" href="/rss.xml"/>
<meta property="og:type" content={schema?'article':'website'}/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={`${site.url}/social.png`}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="GuideHollow Sheets. Practical spreadsheet help, one cell at a time."/>
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${site.url}/social.png`}/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/>
</head><body><a class="skip-link" href="#main">Skip to content</a>
<div class="network-strip"><div class="container"><span>A GuideHollow publication</span><a href="https://guidehollow.com/">Explore the AI guides ↗</a></div></div>
<header class="site-header"><div class="container header-row"><a class="brand" href="/" aria-label="GuideHollow Sheets home"><svg width="35" height="35" viewBox="0 0 36 36" aria-hidden="true"><rect x="1" y="1" width="34" height="34" rx="9" fill="#123d44"/><path d="M9 10h18v17H9zM9 16h18M15 10v17M21 10v17" stroke="#c2e8d6" fill="none"/><path d="m22 20 2 2 4-5" stroke="#d6f586" fill="none" stroke-width="2"/></svg><span>GuideHollow <strong>Sheets<span class="brand-dot">.</span></strong></span></a>
<nav id="main-nav" aria-label="Main navigation"><a href="/guides/" aria-current={Astro.url.pathname==='/guides/'?'page':undefined}>All guides</a><a href="/formulas/">Formulas</a><a href="/data-cleaning/">Data cleaning</a><a href="/tools/" aria-current={Astro.url.pathname.startsWith('/tools/')?'page':undefined}>Free tools <span class="nav-badge">2</span></a></nav>
<div class="header-actions"><a class="search-icon" href="/search/" aria-label="Search guides"><svg width="19" height="19" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.6"/></svg><span>Search</span></a><button class="menu-toggle" id="menu-toggle" aria-controls="main-nav" aria-expanded="false">Menu</button></div></div></header>
<main id="main" class="container">{breadcrumbs.length>0&&<nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li>{breadcrumbs.map((b,i)=><li>{i===breadcrumbs.length-1?<span aria-current="page">{b.name}</span>:<a href={b.url}>{b.name}</a>}</li>)}</ol></nav>}<slot/></main>
<footer><div class="container footer-grid"><div><a class="brand" href="/">GuideHollow <strong>Sheets.</strong></a><p>Less spreadsheet friction.<br/>More time for the work that matters.</p><span class="small">Independent guides. Transparent examples.</span></div><nav aria-label="Learn"><strong>Find your answer</strong><a href="/guides/">All guides</a><a href="/troubleshooting/">Troubleshooting</a><a href="/templates/">Templates & examples</a><a href="/comparisons/">Excel vs Sheets</a></nav><nav aria-label="Publication"><strong>The publication</strong><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/editorial-policy/">Editorial policy</a><a href="/rss.xml">RSS feed</a></nav><nav aria-label="Legal"><strong>The details</strong><a href="/privacy-policy/">Privacy policy</a><a href="/terms/">Terms of use</a><a href={site.repository}>Source & corrections ↗</a></nav></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} GuideHollow Sheets</span><span>Made for the way you actually work.</span><a href="#main">Back to top ↑</a></div></footer>
<script>import '../scripts/site';</script></body></html>
