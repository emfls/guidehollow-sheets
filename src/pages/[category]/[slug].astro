---
import {render} from 'astro:content';import Base from '../../layouts/Base.astro';import GuideCard from '../../components/GuideCard.astro';import {categories,site} from '../../config';import {publishedArticles,articleUrl,dateLabel,readingMinutes} from '../../lib/content';
export async function getStaticPaths(){return (await publishedArticles()).map(post=>({params:{category:post.data.category,slug:post.data.slug},props:{post}}));}
const {post}=Astro.props;const {Content,headings}=await render(post);const category=categories.find(c=>c.slug===post.data.category)!;
const related=(await publishedArticles()).filter(p=>p.id!==post.id).sort((a,b)=>Number(b.data.category===post.data.category)-Number(a.data.category===post.data.category)).slice(0,3);
const schema={'@type':'BlogPosting',headline:post.data.title,description:post.data.description,dateCreated:post.data.publishedDate.toISOString().slice(0,10),...(site.launchedOn?{datePublished:post.data.publishedDate.toISOString().slice(0,10)}:{}),dateModified:post.data.updatedDate.toISOString().slice(0,10),author:{'@type':'Organization',name:post.data.author,url:`${site.url}/editorial-policy/`},publisher:{'@id':`${site.url}/#publisher`},mainEntityOfPage:new URL(articleUrl(post),site.url).href,image:`${site.url}/social.png`,inLanguage:site.language};
---
<Base title={post.data.title} description={post.data.description} schema={schema} breadcrumbs={[{name:category.name,url:`/${category.slug}/`},{name:post.data.title,url:articleUrl(post)}]}><header class="article-heading"><p class="eyebrow">{category.name} <span aria-hidden="true">/</span> {readingMinutes(post.body)} min read</p><h1>{post.data.title}</h1><p class="lede">{post.data.description}</p><div class="article-meta"><a href="/editorial-policy/">{post.data.author}</a><span>{site.launchedOn?'Published':'Prepared'} <time datetime={post.data.publishedDate.toISOString()}>{dateLabel(post.data.publishedDate)}</time></span><span>Updated <time datetime={post.data.updatedDate.toISOString()}>{dateLabel(post.data.updatedDate)}</time></span></div></header><div class="reading-layout"><aside class="toc"><details open><summary>In this guide</summary><ol>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}<li><a href="#official-sources">Sources & verification</a></li></ol></details></aside><article class="prose" data-notion-page-id={post.data.notionPageId}><Content/><section id="official-sources" class="sources"><h2>Sources & verification</h2><ul>{post.data.sources.map(source=><li><a href={source.url}>{source.title} ↗</a></li>)}</ul><div class="verification-note"><strong>What was checked</strong>{post.data.verification}</div><p>Found an error or a product change? <a href="/contact/">Send a correction</a> with this page URL and the evidence.</p></section></article></div><section class="section section-rule"><div class="section-heading"><h2>Keep your workflow moving.</h2><a href="/guides/" class="text-link">All guides ↗</a></div><div class="guide-grid">{related.map(post=><GuideCard post={post}/>)}</div></section></Base>
